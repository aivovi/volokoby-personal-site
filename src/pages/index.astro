---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Volodymyr Kobyletsky builds mobile apps, including Glimzy." />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Volodymyr Kobyletsky</title>
  </head>
  <body>
    <main>
      <section class="intro">
        <h1>Hi, my name is Volodymyr<br />Kobyletsky</h1>
        <img
          class="portrait"
          src="/volodymyr.jpg"
          alt="Volodymyr Kobyletsky"
          width="88"
          height="88"
        />
      </section>

      <section>
        <h2>I build mobile apps</h2>
        <div class="icon-row product-row">
          <a
            class="app-icon"
            href="https://apps.apple.com/app/inputflow-english-podcasts/id6772201351"
            target="_blank"
            rel="noreferrer"
            aria-label="Open Glimzy on the App Store"
          >
            <img src="/glimzy.jpg" alt="Glimzy" width="76" height="76" />
          </a>
        </div>
      </section>

      <section>
        <h2>I also post regularly on<br />these platforms</h2>
        <nav class="icon-row" aria-label="Social media">
          <a class="social-icon x-icon" href="https://x.com/volokoby" target="_blank" rel="noreferrer" aria-label="X">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a class="social-icon instagram-icon" href="https://www.instagram.com/volokoby" target="_blank" rel="noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
              <circle cx="12" cy="12" r="4.25" />
              <circle class="dot" cx="17.45" cy="6.65" r="1.05" />
            </svg>
          </a>
          <a class="social-icon linkedin-icon" href="https://www.linkedin.com/in/volodymyr-kobyletsky-088493281/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.4 8.35v10.6H2.85V8.35H6.4ZM4.62 3.05a2.06 2.06 0 1 1 0 4.12 2.06 2.06 0 0 1 0-4.12ZM12.1 8.35v1.45h.05c.5-.96 1.73-1.97 3.56-1.97 3.8 0 4.51 2.5 4.51 5.76v5.36h-3.54V14.2c0-1.13-.02-2.59-1.58-2.59-1.58 0-1.82 1.24-1.82 2.51v4.83H9.74V8.35h2.36Z" />
            </svg>
          </a>
        </nav>
      </section>
    </main>
  </body>
</html>
